<odoo>


<record id="res_partner_view_purchase_buttons" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="purchase.res_partner_view_purchase_buttons"/>
    <field name="arch" type="xml">
        <button name="%(purchase.act_res_partner_2_purchase_order)d" type="action" position="attributes">
            <attribute name="groups" add="purchase_viewer.group_purchase_viewer" separator=","/>
        </button>
        <xpath expr="//field[@name='purchase_warn']/../.." position="attributes">
            <attribute name="groups" add="purchase_viewer.group_purchase_viewer" separator=","/>
        </xpath>
    </field>
</record>

<record id="purchase_partner_kanban_view" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="purchase.purchase_partner_kanban_view"/>
    <field name="arch" type="xml">
        <field name="purchase_order_count" position="attributes">
            <attribute name="groups" add="purchase_viewer.group_purchase_viewer" separator=","/>
        </field>
        <a data-type="action" data-name="%(purchase.act_res_partner_2_purchase_order)d" position="attributes">
            <attribute name="groups" add="purchase_viewer.group_purchase_viewer" separator=","/>
        </a>
    </field>
</record>

<record id="purchase.act_res_partner_2_purchase_order" model="ir.actions.act_window">
    <field name="groups_id" eval="[(4, ref('purchase_viewer.group_purchase_viewer'))]"/>
</record>



</odoo>
